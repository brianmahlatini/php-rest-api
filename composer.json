{
    "name": "brianmahlatini/php-rest-api",
    "description": "Framework-free PHP 8.3 REST API: JWT auth, RBAC, rate limiting, PDO repositories, migrations, RFC 7807 errors",
    "type": "project",
    "license": "MIT",
    "authors": [{ "name": "Brian Mahlatini" }],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff"
    },
    "config": { "sort-packages": true }
}
